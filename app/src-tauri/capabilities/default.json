{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, every platform",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:allow-reveal-item-in-dir",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/saucyeng/idl1-app/*" }]
    }
  ]
}
